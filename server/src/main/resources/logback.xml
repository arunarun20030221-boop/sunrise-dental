<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging configuration.

  Without this, Logback defaults to DEBUG for everything and Spring's own startup chatter
  buries the application's messages entirely. Our own package stays at INFO so that logins,
  bookings and email failures remain visible; the framework is quietened to WARN.
-->
<configuration>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss} %-5level [%thread] %logger{28} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- The clinic's own code: keep the operational trail. -->
    <logger name="com.sunrise.dental" level="INFO"/>

    <!-- Frameworks: only tell us when something is actually wrong. -->
    <logger name="org.springframework" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>

    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
